{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/artists/:slug",
      "destination": "/api/artists?resource=artist-page&slug=:slug"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/artists?resource=news-page&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/artists?resource=sitemap"
    },
    {
      "source": "/submit-artist",
      "destination": "/submit-artist.html"
    },
    {
      "source": "/api/admin-news-ai",
      "destination": "/api/artists?resource=news-ai"
    },
    {
      "source": "/api/admin-news",
      "destination": "/api/artists?resource=admin-news"
    },
    {
      "source": "/api/news",
      "destination": "/api/artists?resource=news"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
